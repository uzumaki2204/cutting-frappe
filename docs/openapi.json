    "/api/method/cutting.api.sync_records": {
      "post": {
        "operationId": "cutting_api_sync_records",
        "summary": "Atomically sync creates, updates and soft deletes",
        "tags": [
          "Tablet"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Successful Frappe method response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "$ref": "#/components/schemas/SyncResult"
                    }
                  }
                },
                "example": {
                  "message": {
                    "accepted_count": 1,
                    "accepted_local_event_ids": [
                      "event-1"
                    ],
                    "accepted_update_count": 0,
                    "accepted_update_local_event_ids": [],
                    "accepted_delete_count": 0,
                    "accepted_delete_local_event_ids": []
                  }
                }
              }
            }
          },
          "403": {
            "description": "Device approval or User role denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrappeError"
                }
              }
            }
          },
          "404": {
            "description": "Device or record not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrappeError"
                }
              }
            }
          },
          "417": {
            "description": "Localized validation error; no writes from the failed batch are committed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrappeError"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write conflict. Retain the queue and retry the same event IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrappeError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "description": "At most 500 operations. Creates are idempotent by device/local_event_id, including after later edits. Updates and deletes are limited to the owning device. A validation failure rolls back the whole batch.",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "records": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/SyncItem"
                    }
                  },
                  "updates": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/SyncItem"
                    }
                  },
                  "deletes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/DeleteItem"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
