{
  "openapi": "3.1.0",
  "info": {
    "title": "Cutting API",
    "version": "0.1.4",
    "description": "Standalone Cutting for Frappe 16. Tablet calls use approved Factory Device IDs. Desk calls use Frappe User roles. No .NET API compatibility routes or machine ingest."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
